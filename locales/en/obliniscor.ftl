# obliNiscor message identifiers (English).
#
# Suite rule (NFR-I18N-1): every key exists here **and** in `locales/fr`, otherwise
# `cargo xtask ci` fails. No visible string is written in code.

# Availability of a function per system (matrix 6.0, ADR-009).
availability-full = Available
availability-partial = Available with extra privileges
availability-unavailable = Not available on this system
